# DATABASE PARAMETERS
DATABASE_URL=postgresql://aether_db_user:aether_db_password_99@localhost:5432/realestate_saas?schema=public

# PORT OF NestJS BACKEND
PORT=3001

# JWT CONFIGURATION
JWT_SECRET=YOUR_SECURE_JWT_SECRET_STRING_HERE

# CACHE LAYER (Redis)
REDIS_URL=redis://localhost:6379/0

# AI SERVICE URL
AI_SERVICE_URL=http://localhost:8000
# The API and CAD worker must share this private service credential.
CAD_SERVICE_TOKEN=REPLACE_WITH_A_RANDOM_PRIVATE_TOKEN
CAD_WORKER_ENABLED=true
DB_SCHEMA=public
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003
NEXT_PUBLIC_VIEWER_URL=http://localhost:3000
# Legacy simulations and OCR fallbacks are opt-in demonstrations.
ENABLE_LEGACY_CAD_DEMOS=false
NEXT_PUBLIC_ENABLE_LEGACY_CAD_DEMOS=false

# GOOGLE AI STUDIO (Optional - Vision LLMs)
GEMINI_API_KEY=

# ANTHROPIC CLAUDE API (Optional)
CLAUDE_API_KEY=

# RAZORPAY CONFIGURATION (Phase 11)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# UPLOADS CONFIGURATION
UPLOAD_DIR=./apps/api/uploads
