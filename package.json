{
  "name": "real-estate-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:builder": "npm run dev --workspace=apps/builder",
    "dev:ai": "node tools/canonical/start-worker.cjs",
    "test:canonical": "node tools/canonical/core-tests.cjs",
    "test:canonical:api": "node tools/canonical/compile-api.cjs && node tools/canonical/api-integration.cjs",
    "test:canonical:browser": "node tools/canonical/browser-tests.cjs",
    "build:verify": "node tools/canonical/build-apps.cjs && node tools/canonical/build-api.cjs",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:admin\" \"npm run dev:builder\" \"npm run dev:ai\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.60.0",
    "ajv": "6.12.6"
  }
}
